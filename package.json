{
  "name": "wanim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:browser": "pnpm build && node scripts/build-browser.mjs",
    "build:py2js": "node scripts/build-py2js.mjs",
    "build:element": "node scripts/build-element.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "build:rapydscript": "node scripts/build-rapydscript-browser.mjs",
    "build:demo": "pnpm build:browser && pnpm build:rapydscript && pnpm build:py2js && pnpm build:element && pnpm build:editor",
    "build:packages": "node scripts/build-packages.mjs",
    "pack:packages": "node scripts/build-packages.mjs --skip-build --pack",
    "demo": "node scripts/demo-server.mjs",
    "smoke:editor": "node scripts/editor_smoke.mjs",
    "test": "vitest run",
    "test:py2js": "tsc py2js/src/preprocess.ts py2js/src/compile_error.ts py2js/src/runtime_core.ts --outDir py2js/dist --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --strict && node py2js/tests/preprocess.node-test.mjs && node py2js/tests/compile_error.node-test.mjs && node py2js/tests/runtime_core.node-test.mjs && node py2js/tests/animate-bridge.node-test.mjs && node py2js/tests/rapydscript_compile.node-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mathjax-full": "^3.2.2",
    "numpy-ts": "^1.7.0",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@types/opentype.js": "^1.3.10",
    "@uiw/codemirror-extensions-basic-setup": "^4.25.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "4.1.9"
  }
}
