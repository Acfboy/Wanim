node_modules/
dist/
*.log
media/

# Assembled publishable npm packages (scripts/build-packages.mjs)
packages-out/

# Package-variant browser bundles (bare numpy-ts / external MathJax)
dist-pkg/

# rapydscript-ng checkout cache (fetched by scripts/build-rapydscript-browser.mjs)
.rapydscript-ng/

# py2js build output (preprocess unit test)
py2js/dist/

