node_modules/
dist/
*.log
media/

# Assembled publishable npm packages (scripts/build-packages.mjs)
packages-out/

# rapydscript-ng checkout cache (fetched by scripts/build-rapydscript-browser.mjs)
.rapydscript-ng/

# py2js build output (preprocess unit test)
py2js/dist/

# The shipped default fonts live in assets/fonts; this convenience dir stays
# ignored so a locally dropped system font does not get committed.
src/mobject/text/pango/fonts/*.ttf
src/mobject/text/pango/fonts/*.otf

# Demo scratch
demo/*.mjson
