{
  "name": "wanim-core",
  "version": "0.1.0",
  "description": "Manim-compatible animation library in TypeScript with a real-time Canvas2D browser backend.",
  "keywords": [
    "manim",
    "animation",
    "canvas",
    "math",
    "visualization",
    "typescript",
    "webgl"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./browser/wanim.browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./browser/wanim.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./browser/wanim.browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "browser",
    "src/_config/default.cfg",
    "src/templates",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/utils/numpy_config.js"
  ],
  "dependencies": {
    "mathjax-full": "^3.2.2",
    "numpy-ts": "^1.7.0",
    "opentype.js": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acfboy/Wanim.git",
    "directory": "wanim"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
